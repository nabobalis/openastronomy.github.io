---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type Post = CollectionEntry<"posts">;
const posts = (await getCollection("posts")).sort(
  (a: Post, b: Post) => b.data.date.getTime() - a.data.date.getTime(),
);
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<PageLayout
  title="News and Events"
  description="News and event announcements from OpenAstronomy."
>
  <div>
    {posts.map((post: Post) => (
      <article>
        <h2>
          <a href={`/news/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p class="post-meta">{dateFormatter.format(post.data.date)}</p>
        {post.data.summary && <p>{post.data.summary}</p>}
      </article>
    ))}
  </div>
</PageLayout>
