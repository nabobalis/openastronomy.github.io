---
// /news/ — lists all blog posts sorted by date, newest first.
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { getPostUrl, getPostDateParts, getExcerpt } from "../lib/posts.js";
import { localizeHref } from "../lib/relative-paths.js";

const posts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const pagePath = Astro.url.pathname;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<PageLayout title="News and Events">
  <div>
    {
      posts.map((post) => {
        const { date } = getPostDateParts(post);
        const postHref = localizeHref(pagePath, getPostUrl(post));
        return (
          <article>
            <h2>
              <a href={postHref}>{post.data.title}</a>
            </h2>
            <p class="post-meta">{dateFormatter.format(date)}</p>
            <p>{getExcerpt(post)}</p>
          </article>
        );
      })
    }
  </div>
</PageLayout>
