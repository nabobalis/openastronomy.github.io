---
import BaseLayout from "./BaseLayout.astro";

type Props = { title: string; date: Date; description?: string };

const { title, date, description } = Astro.props as Props;
const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(date);
---

<BaseLayout
  title={title}
  description={description}
  pageType="article"
  publishedAt={date}
>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="post-meta">{formattedDate}</p>
    </header>
    <slot />
  </article>
</BaseLayout>
