---
/**
 * Renders the project metadata block. Slot is the markdown body.
 *
 * Used inside <dialog> by ProjectDetail and as a standalone page section by
 * [...slug].astro for direct project URLs.
 */
import type { ProjectMeta } from "../../lib/gsoc.ts";

type Props = { project: ProjectMeta; showOpenLink?: boolean };
const { project, showOpenLink = true } = Astro.props as Props;

const rows = [
  { label: "Initiatives", values: project.initiatives },
  { label: "Project size", values: project.projectSize },
  { label: "Tags", values: project.tags },
].filter((r) => r.values.length > 0);
---

{
  showOpenLink ? (
    <p class="gsoc-project-detail-link">
      <a href={project.href}>Open project page</a>
    </p>
  ) : null
}
<h3>{project.name}</h3>
{project.desc ? <p>{project.desc}</p> : null}

{
  project.requirements.length > 0 ? (
    <div>
      <strong>Requirements:</strong>
      <ul>
        {project.requirements.map((req) => (
          <li>{req}</li>
        ))}
      </ul>
    </div>
  ) : null
}

{
  rows.map((row) => (
    <div>
      <strong>{row.label}:</strong> {row.values.join(", ")}
    </div>
  ))
}

{
  project.mentors.length > 0 ? (
    <div>
      <strong>Mentors:</strong>{" "}
      {project.mentors.map((mentor, index) => (
        <>
          {index > 0 ? ", " : ""}
          <a
            href={`https://github.com/${mentor}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            @{mentor}
          </a>
        </>
      ))}
    </div>
  ) : null
}

{
  project.issues.length > 0 ? (
    <div>
      <strong>Related issues:</strong>
      <ul>
        {project.issues.map((issue) => (
          <li>
            <a href={issue} target="_blank" rel="noopener noreferrer">
              {issue}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : null
}

{
  project.collaborators.length > 0 ? (
    <div>
      <strong>Collaborating projects:</strong>{" "}
      {project.collaborators.map((collaborator, index) => (
        <>
          {index > 0 ? ", " : ""}
          {collaborator.href ? (
            <a href={collaborator.href}>{collaborator.label}</a>
          ) : (
            collaborator.label
          )}
        </>
      ))}
    </div>
  ) : null
}

<div class="gsoc-project-body">
  <slot />
</div>
