---
import { getProjectCardRows, type ProjectMeta } from "../../lib/gsoc.ts";

const { project } = Astro.props as { project: ProjectMeta };
const rows = getProjectCardRows(project);
---

<article class="gsoc-project-card">
  <h3>
    <a href={project.href}>{project.name}</a>
  </h3>
  {project.desc ? <p class="gsoc-project-desc">{project.desc}</p> : null}
  {rows.map((row) => (
    <div class="gsoc-card-row">
      <span class="gsoc-card-label">{row.label}:</span>{" "}
      <span>{row.values.join(", ")}</span>
    </div>
  ))}
  {project.collaborators.length > 0 ? (
    <div class="gsoc-card-row">
      <span class="gsoc-card-label">Project:</span>{" "}
      <span>
        {project.collaborators.map((collaborator, index) => (
          <>
            {index > 0 ? ", " : ""}
            {collaborator.href ? (
              <a href={collaborator.href}>{collaborator.label}</a>
            ) : (
              collaborator.label
            )}
          </>
        ))}
      </span>
    </div>
  ) : null}
</article>
