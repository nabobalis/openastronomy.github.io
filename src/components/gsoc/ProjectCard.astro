---
/**
 * Summary card for a single GSoC project idea, shown in the season grid.
 * Clicking the card opens the detail modal via the data-project-detail attribute.
 */
import type { GsocProject } from "../../lib/gsoc.ts";

const { project } = Astro.props as { project: GsocProject };
const detailId = `detail-${project.anchor}`;
---

<button class="gsoc-project-card" type="button" data-project-detail={detailId}>
  <h3>{project.name}</h3>
  {project.desc ? <p class="gsoc-project-desc">{project.desc}</p> : null}
  {
    project.cardRows.map((row) => (
      <div class="gsoc-card-row">
        <span class="gsoc-card-label">{row.label}:</span>
        <span>{row.values.join(", ")}</span>
      </div>
    ))
  }
  {
    project.collaborators.length > 0 ? (
      <div class="gsoc-card-row">
        <span class="gsoc-card-label">Project:</span>
        <span>
          {project.collaborators.map((collaborator, index) => (
            <>
              {index > 0 ? ", " : ""}
              {collaborator.href ? (
                <a href={collaborator.href}>{collaborator.label}</a>
              ) : (
                collaborator.label
              )}
            </>
          ))}
        </span>
      </div>
    ) : null
  }
</button>
