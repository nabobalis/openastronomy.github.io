---
/**
 * Summary card for one GSoC project. Click opens the matching <dialog>.
 */
import type { GsocProject } from "../../lib/gsoc.ts";

const { project } = Astro.props as { project: GsocProject };

const rows = [
  { label: "Mentors", values: project.mentors },
  { label: "Initiatives", values: project.initiatives },
  { label: "Project size", values: project.projectSize },
  { label: "Tags", values: project.tags },
].filter((r) => r.values.length > 0);
---

<button
  class="gsoc-project-card"
  type="button"
  data-detail={`detail-${project.anchor}`}
>
  <h3>{project.name}</h3>
  {project.desc ? <p class="gsoc-project-desc">{project.desc}</p> : null}
  {
    rows.map((row) => (
      <div class="gsoc-card-row">
        <span class="gsoc-card-label">{row.label}:</span>
        <span>{row.values.join(", ")}</span>
      </div>
    ))
  }
  {
    project.collaborators.length > 0 ? (
      <div class="gsoc-card-row">
        <span class="gsoc-card-label">Project:</span>
        <span>
          {project.collaborators.map((collaborator, index) => (
            <>
              {index > 0 ? ", " : ""}
              {collaborator.href ? (
                <a href={collaborator.href}>{collaborator.label}</a>
              ) : (
                collaborator.label
              )}
            </>
          ))}
        </span>
      </div>
    ) : null
  }
</button>
