---
/**
 * Expanded detail panel for a GSoC project.
 *
 * This element is rendered `hidden` in the page and its content is copied into
 * the modal overlay when the user clicks the corresponding ProjectCard. It must
 * have an `id` that matches the `data-project-detail` attribute of the card.
 */
import type { GsocProject } from "../../lib/gsoc.ts";

const { project } = Astro.props as { project: GsocProject };
const ProjectContent = project.Content;
---

<div class="gsoc-project-detail" id={`detail-${project.anchor}`} hidden>
  <p class="gsoc-project-detail-link">
    <a href={project.href}>Open project page</a>
  </p>
  <h3>{project.name}</h3>
  {project.desc ? <p>{project.desc}</p> : null}

  {
    project.requirements.length > 0 ? (
      <div>
        <strong>Requirements:</strong>
        <ul>
          {project.requirements.map((req) => (
            <li>{req}</li>
          ))}
        </ul>
      </div>
    ) : null
  }

  {
    project.detailRows.map((row) => (
      <div>
        <strong>{row.label}:</strong> {row.values.join(", ")}
      </div>
    ))
  }

  {
    project.mentors.length > 0 ? (
      <div>
        <strong>Mentors:</strong>{" "}
        {project.mentors.map((mentor, index) => (
          <>
            {index > 0 ? ", " : ""}
            <a href={`https://github.com/${mentor}`} target="_blank">
              @{mentor}
            </a>
          </>
        ))}
      </div>
    ) : null
  }

  {
    project.issues.length > 0 ? (
      <div>
        <strong>Related issues:</strong>
        <ul>
          {project.issues.map((issue) => (
            <li>
              <a href={issue} target="_blank">
                {issue}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : null
  }

  {
    project.collaborators.length > 0 ? (
      <div>
        <strong>Collaborating projects:</strong>{" "}
        {project.collaborators.map((collaborator, index) => (
          <>
            {index > 0 ? ", " : ""}
            {collaborator.href ? (
              <a href={collaborator.href}>{collaborator.label}</a>
            ) : (
              collaborator.label
            )}
          </>
        ))}
      </div>
    ) : null
  }

  <div class="gsoc-project-body">
    <ProjectContent />
  </div>
</div>
