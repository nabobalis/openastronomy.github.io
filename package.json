{
  "name": "openastronomy-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"src/**/*.{astro,js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{astro,js,ts}\" --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "astro:check": "astro check",
    "check": "npm run lint && npm run astro:check",
    "linkcheck": "lychee --no-progress --root-dir \"$PWD/html\" --remap \"^https://openastronomy\\.org/(.*)$ file://$PWD/html/\\$1\" html"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
